<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    A library manifest only contributes children of <application>; a bare
    <service> at the top level fails resource linking with
    "unexpected element <service> found in <manifest>".
  -->
  <application>

    <!--
      The FCM entry point: being the service Firebase resolves for
      `com.google.firebase.MESSAGING_EVENT` is what makes the background activity
      launch possible, and that decision cannot be taken in JS, which is not
      consulted when a push arrives while the app is in the background.

      Declaring this service is not enough. Firebase starts a single service and
      picks the first declared, so the two competitors shipped by expo-notifications
      must be removed from the merged manifest — and that removal **cannot live
      here**. A library manifest has lower merge priority than the library it would
      edit, so a `tools:node="remove"` written in this file is dropped without a
      warning. It is applied in the app manifest instead, by
      `plugins/withRemoveCompetingFcmServices.js`, which also explains why.

      `android:priority` is deliberately absent: it reads like a guarantee that the
      highest priority wins, and it is not one.
    -->
    <service
      android:name="expo.modules.veoverlay.VeFirebaseMessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>

  </application>

</manifest>
