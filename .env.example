# vector-elegans environment
# Copy to `.env` (gitignored). Switch backends with the scripts below — no remote
# Expo project required for day-to-day work.
#
# Local Docker (default for Expo Go on device — use LAN IP, not localhost):
#   ./scripts/sync-local-supabase-env.sh
#
# Same Supabase cloud as elegance-mobilite on Vercel:
#   ./scripts/use-cloud-supabase-env.sh
#
# After either script: npx expo start -c

# --- Local (LAN) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54329
# EXPO_PUBLIC_SUPABASE_URL=http://<YOUR_MAC_LAN_IP>:54329
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_SUPABASE_STORAGE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_API_URL=http://127.0.0.1:54329

# --- Cloud (same project as Vercel — fill or let use-cloud-supabase-env.sh sync) ---
# EXPO_PUBLIC_SUPABASE_URL=https://iodsddzustunlahxafif.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-cloud-anon-key
# EXPO_PUBLIC_SUPABASE_STORAGE_ANON_KEY=your-cloud-anon-key
# EXPO_PUBLIC_API_URL=https://iodsddzustunlahxafif.supabase.co

# Optional CI / EAS
# EXPO_TOKEN=
